# API

## 1.Admin

### 1.1 Login
POST http://localhost:9092/admin/login
Content-Type: application/json

{
    "email": "{{$dotenv ADMIN_EMAIL}}",
    "password": "{{$dotenv ADMIN_PASSWORD}}",
    "rememberMe": false
}

### 1.2 Signup
// ใช้ได้เฉพาะตอนที่ยังไม่มี Super Admin (ครั้งแรกหลัง setup เท่านั้น)
POST http://localhost:9092/admin/register-admin
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6MSwiaWF0IjoxNzkwMTM1MTY3LCJleHAiOjE3OTI3MjcxNjd9.8wgiznCDQ2giE82bm_9-y5cxAdplRGlYI9lZ35Cik6Q

{
    "firstname": "Admin4",
    "lastname": "Test",
    "email": "admin4@example.com",
    "password": "Admin4567!"
}

### 1.3 Forgot Password
POST http://localhost:9092/admin/forgot-password
Content-Type: application/json

{
    "email": "thananop0084@gmail.com"
}

### 1.3.1 Reset Password
// เอา token (query param ชื่อ code) จากลิงก์ในอีเมลที่ 1.3 ส่งกลับไปใส่ใน field resetPasswordToken
POST http://localhost:9092/admin/reset-password
Content-Type: application/json

{
    "resetPasswordToken": "90d31f264fd7cc6917bd624d1fe1fcf67f82b35b",
    "password": "Phungdokmai789"
}

### 1.4 Profile
// เอา token จาก response ของข้อ 1.1 ไปใส่ใน Authorization
GET http://localhost:9092/admin/users/me
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6MSwiaWF0IjoxNzkwMTM1MTY3LCJleHAiOjE3OTI3MjcxNjd9.8wgiznCDQ2giE82bm_9-y5cxAdplRGlYI9lZ35Cik6Q

## 2.User

### 2.1 Login
POST http://localhost:9092/api/auth/local
Content-Type: application/json

{
    "identifier": "user@example.com",
    "password": "User1234!"
}

### 2.2 Signup
POST http://localhost:9092/api/auth/local/register
Content-Type: application/json

{
    "username": "user123",
    "email": "user@gmail.com",
    "password": "12345_"
}
### 2.3 Forgot Password
// Strapi จะคืน 500 ถ้ายังไม่ได้ตั้งค่า SMTP สำหรับส่งอีเมล
POST http://localhost:9092/api/auth/forgot-password
Content-Type: application/json

{
    "email": "user@example.com"
}

### 2.3.1 Reset Password
// เอา code จากลิงก์ในอีเมลที่ 2.3 ส่งกลับไปใส่ใน field code
POST http://localhost:9092/api/auth/reset-password
Content-Type: application/json

{
    "code": "<code-from-email>",
    "password": "NewPass123!",
    "passwordConfirmation": "NewPass123!"
}

### 2.4 Profile
// เอา token จาก response ของข้อ 2.1 ไปใส่ใน Authorization
GET http://localhost:9092/api/users/me
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6NywiaWF0IjoxNzkwMTM3NDQwLCJleHAiOjE3OTI3Mjk0NDB9.QHRDZhyVujV2LuG05EvoUmzfDxDAEgYPSZ3BV3wUFUY

## 3.Content

### 3.1 Student

### 3.1.1 Create
// เอา token จาก response ของข้อ 1.1 หรือ 2.1 ไปใส่ใน Authorization
POST http://localhost:9092/api/students
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6NywiaWF0IjoxNzkwMTM3NDQwLCJleHAiOjE3OTI3Mjk0NDB9.QHRDZhyVujV2LuG05EvoUmzfDxDAEgYPSZ3BV3wUFUY

{
    "data": {
        "name": "Somchai Jaidee",
        "mobile": "0812345678",
        "cardId": "1234567890123"
    }
}

### 3.1.2 List All
GET http://localhost:9092/api/students
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6NywiaWF0IjoxNzkwMTM3NDQwLCJleHAiOjE3OTI3Mjk0NDB9.QHRDZhyVujV2LuG05EvoUmzfDxDAEgYPSZ3BV3wUFUY

### 3.1.3 List with ID
GET http://localhost:9092/api/students/3
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6NywiaWF0IjoxNzkwMTM3NDQwLCJleHAiOjE3OTI3Mjk0NDB9.QHRDZhyVujV2LuG05EvoUmzfDxDAEgYPSZ3BV3wUFUY

### 3.1.4 Update
PUT http://localhost:9092/api/students/3
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6NywiaWF0IjoxNzkwMTM3NDQwLCJleHAiOjE3OTI3Mjk0NDB9.QHRDZhyVujV2LuG05EvoUmzfDxDAEgYPSZ3BV3wUFUY

{
    "data": {
        "name": "AAAA BBBB Updated",
        "mobile": "0234448888",
        "cardId": "0234448888111"
    }
}

### 3.1.5 Delete
DELETE http://localhost:9092/api/students/3
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6NywiaWF0IjoxNzkwMTM3NDQwLCJleHAiOjE3OTI3Mjk0NDB9.QHRDZhyVujV2LuG05EvoUmzfDxDAEgYPSZ3BV3wUFUY

### 3.2 Subject

### 3.2.1 Create
POST http://localhost:9092/api/subjects
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6NywiaWF0IjoxNzkwMTM3NDQwLCJleHAiOjE3OTI3Mjk0NDB9.QHRDZhyVujV2LuG05EvoUmzfDxDAEgYPSZ3BV3wUFUY

{
    "data": {
        "name": "Mathematics"
    }
}

### 3.2.2 List All
GET http://localhost:9092/api/subjects
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6NywiaWF0IjoxNzkwMTM3NDQwLCJleHAiOjE3OTI3Mjk0NDB9.QHRDZhyVujV2LuG05EvoUmzfDxDAEgYPSZ3BV3wUFUY

### 3.2.3 List with ID
GET http://localhost:9092/api/subjects/:id
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6NywiaWF0IjoxNzkwMTM3NDQwLCJleHAiOjE3OTI3Mjk0NDB9.QHRDZhyVujV2LuG05EvoUmzfDxDAEgYPSZ3BV3wUFUY

### 3.2.4 Update
PUT http://localhost:9092/api/subjects/:id
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6NywiaWF0IjoxNzkwMTM3NDQwLCJleHAiOjE3OTI3Mjk0NDB9.QHRDZhyVujV2LuG05EvoUmzfDxDAEgYPSZ3BV3wUFUY

{
    "data": {
        "name": ""
    }
}

### 3.2.5 Delete
DELETE http://localhost:9092/api/subjects/:id
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6NywiaWF0IjoxNzkwMTM3NDQwLCJleHAiOjE3OTI3Mjk0NDB9.QHRDZhyVujV2LuG05EvoUmzfDxDAEgYPSZ3BV3wUFUY

